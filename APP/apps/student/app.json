{
  "expo": {
    "name": "SSA Student",
    "slug": "ssa-student",
    "scheme": "ssa-student",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ssa.erp.student"
    },
    "android": {
      "package": "com.ssa.erp.student",
      "adaptiveIcon": {
        "backgroundColor": "#FF6B2C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#FF6B2C"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SSA to use your photos to submit homework.",
          "cameraPermission": "Allow SSA to use the camera to photograph homework.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
